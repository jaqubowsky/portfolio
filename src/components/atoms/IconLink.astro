---
import { Link } from "@components/atoms";
import { cn } from "@utils/cn";
import { Icon } from "astro-icon/components";

type Props = {
  class?: string;
  size?: number;
  name: string;
  href: string;
} & React.JSX.IntrinsicElements["a"];

const { class: className, size, name, href, ...rest } = Astro.props;
---

<Link
  aria-label={name}
  class={cn(
    "cursor-pointer inline-flex text-muted-foreground transition-[color,transform] duration-200 ease-out hover:text-primary hover:-translate-y-0.5 focus-visible:text-primary",
    className,
  )}
  href={href}
  {...rest}
>
  <Icon name={name} size={size} />
</Link>
