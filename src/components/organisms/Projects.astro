---
import { Picture } from "astro:assets";
import {
  Flex,
  GlowCard,
  Heading,
  Link,
  Paragraph,
  Section,
  Tag,
} from "@components/atoms";
import { SectionHeader } from "@components/molecules";
import { Icon } from "astro-icon/components";
import pillPilotImg from "@images/projects/pill-pilot.webp";
import jobzImg from "@images/projects/jobz.webp";
import substatzImg from "@images/projects/substatz.webp";
import { t, getLocale } from "@i18n";

const locale = getLocale(Astro.currentLocale);
const strings = t(locale);

type ProjectLink = {
  href: string;
  icon: string;
  label: string;
  umamiEvent: string;
};

type Project = {
  title: string;
  description: string;
  tech: string[];
  links: ProjectLink[];
  image: ImageMetadata;
  featured: boolean;
};

const repositoryLink = (href: string): ProjectLink => ({
  href,
  icon: "mdi:github",
  label: "GitHub",
  umamiEvent: "project-github",
});

const projects: Project[] = [
  {
    title: "PillPilot",
    description: strings.projects.items[0].description,
    tech: [
      "Next.js 16",
      "PostgreSQL",
      "Drizzle ORM",
      "Vercel AI SDK",
      "Vitest",
      "Playwright",
      "Docker",
    ],
    links: [repositoryLink("https://github.com/jaqubowsky/pill-pilot")],
    image: pillPilotImg,
    featured: true,
  },
  {
    title: "jobZ",
    description: strings.projects.items[1].description,
    tech: ["Next.js 16", "Supabase", "Transformers.js", "Turborepo"],
    links: [repositoryLink("https://github.com/jaqubowsky/jobZ")],
    image: jobzImg,
    featured: false,
  },
  {
    title: "SubStatZ",
    description: strings.projects.items[2].description,
    tech: ["Next.js 16", "Prisma", "Stripe", "Sentry", "Docker"],
    links: [repositoryLink("https://github.com/jaqubowsky/substatz")],
    image: substatzImg,
    featured: false,
  },
];
---

<Section class="gap-10 max-w-7xl" id="projects">
  <SectionHeader
    title={strings.projects.title}
    description={strings.projects.description}
  />

  <Flex class="flex-col items-stretch gap-6 w-full">
    {
      projects.map((project, i) => (
        <div class={`animate-on-scroll stagger-${i + 1}`}>
          <GlowCard class="p-0 overflow-hidden">
            <Flex class="flex-col lg:flex-row items-stretch overflow-hidden">
              <div class="lg:w-2/5 shrink-0 overflow-hidden">
                <Picture
                  src={project.image}
                  formats={["avif", "webp"]}
                  width={600}
                  alt={`${project.title} preview`}
                  pictureAttributes={{ style: "width: 100%; max-width: 100%; height: 100%;" }}
                  style="width: 100%; max-width: 100%;"
                  class="h-auto lg:h-full object-contain lg:object-cover bg-muted block"
                  loading="lazy"
                />
              </div>
              <Flex class="flex-col gap-3 p-6 sm:p-8 flex-1 items-start">
                <Flex class="items-start justify-between w-full">
                  <Flex class="gap-3 items-center justify-start">
                    <Heading level={3} class="text-2xl">
                      {project.title}
                    </Heading>
                  </Flex>
                  {project.links.length > 0 && (
                    <Flex class="gap-2 shrink-0">
                      {project.links.map((link) => (
                        <Link
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="p-1"
                          aria-label={`${project.title} ${link.label}`}
                          data-umami-event={link.umamiEvent}
                          data-umami-event-project={project.title}
                        >
                          <Icon name={link.icon} size={20} />
                        </Link>
                      ))}
                    </Flex>
                  )}
                </Flex>

                <Paragraph class="text-sm leading-relaxed">
                  {project.description}
                </Paragraph>

                <Flex class="flex-wrap gap-1.5 justify-start mt-auto">
                  {project.tech.map((techItem) => (
                    <Tag variant="mono">{techItem}</Tag>
                  ))}
                </Flex>
              </Flex>
            </Flex>
          </GlowCard>
        </div>
      ))
    }
  </Flex>
</Section>
